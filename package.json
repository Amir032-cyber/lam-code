{
  "name": "lam-code",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LAM-Code — plateforme d'IA agentique de développement (Web, Windows, Android)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "cap": "cap",
    "android:sync": "npm run build && cap sync android",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
